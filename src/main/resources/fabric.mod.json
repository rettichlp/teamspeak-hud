{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "TeamSpeak Integration is a lightweight Fabric mod that connects to your local TeamSpeak 3 client and shows a small HUD overlay listing everyone currently in your TeamSpeak channel, including who's talking, muted, or away.",
  "authors": [
    "RettichLP"
  ],
  "contact": {
    "homepage": "https://rettichlp.de/",
    "sources": "https://github.com/rettichlp/teamspeak-hud",
    "issues": "https://github.com/rettichlp/teamspeak-hud/issues",
    "discord": "https://discord.gg/mZGAAwhPHu"
  },
  "license": "Apache-2.0",
  "icon": "assets/teamspeak-hud/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "de.rettichlp.teamspeakhud.TeamSpeakHud"
    ],
    "modmenu": [
      "de.rettichlp.teamspeakhud.integrations.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "recommends": {
    "modmenu": ">=20.0.0"
  }
}
